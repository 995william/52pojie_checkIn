# 吾爱破解登录 Cookie（必填，支持换行或 @@ 分隔多账号）
# 必须包含 HttpOnly 核心字段 htVC_2132_auth 与 htVC_2132_saltkey
POJIE52_COOKIE=htVC_2132_saltkey=your_saltkey; htVC_2132_auth=your_auth_token

# 私有消息推送配置（可选，由中枢托管时仅在异常失败时单仓直推告警）
WECOM_WEBHOOK=
PUSHPLUS_TOKEN=

# 集中管控中枢上报配置（https://checkin.wwcoder.top）
CHECKIN_HUB_URL=https://checkin.wwcoder.top
CHECKIN_HUB_TOKEN=
HUB_MANAGED_NOTIFY=true
